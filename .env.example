# ==============================================================================
# Environment Configuration untuk AI Chat App (9Router / OpenRouter + Supabase)
# Salin file ini menjadi .env dan isi dengan kunci Anda
# ==============================================================================

# Opsi 1: Menggunakan 9Router Proxy Lokal (Sesuai Dashboard http://localhost:20128)
AI_BASE_URL=http://localhost:20128/v1
AI_MODEL=ANTIGRAVITY_MODEL
# Salin salah satu kunci dari dashboard 9Router (misal: TES atau Default Key):
AI_API_KEY=sk-5ff-salin-dari-dashboard-9router-anda

# Opsi 2: Menggunakan OpenRouter Cloud (Alternatif jika tidak memakai 9Router)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENROUTER_API_KEY=sk-or-v1-kunci-openrouter-anda

# Kredensial Supabase (dapatkan di Dashboard Supabase -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Rahasia Flask Session (opsional)
SECRET_KEY=ai-personal-assistant-secret-key-change-this
